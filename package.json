{
  "name": "openchamber-tps",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "OpenChamber extension panel that shows a rolling 5-second generation rate (TPS) for the open session.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airtaxi/openchamber-tps.git"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.0"
    },
    "contributes": {
      "panel": {
        "id": "tps-meter",
        "name": "TPS Meter",
        "icon": "speed-up-line",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      }
    }
  },
  "scripts": {
    "build": "bun run build:panel && bun run build:service",
    "build:panel": "bunx openchamber-guest-bundle panel/main.ts panel/main.js",
    "build:service": "bunx openchamber-guest-bundle --node service/main.ts service/main.js"
  },
  "dependencies": {
    "@openchamber/sdk": "^1.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3"
  }
}
